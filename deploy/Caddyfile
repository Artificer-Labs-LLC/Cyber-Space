# Caddyfile — TLS termination + reverse proxy for the Cybernet genesis node.
#
# Install on the public host (artificer-labs) as /etc/caddy/Caddyfile,
# then: systemctl enable --now caddy
#
# The node itself listens only on loopback (see deploy/cybernet-node.service);
# Caddy handles public HTTPS and forwards to 127.0.0.1:8471.
#
# Set PUBLIC_HOSTNAME before starting caddy, e.g.:
#   echo 'PUBLIC_HOSTNAME=example.com' >> /etc/caddy/caddy.env
#   (and: EnvironmentFile=/etc/caddy/caddy.env in the caddy unit)

{$PUBLIC_HOSTNAME} {
    reverse_proxy 127.0.0.1:8471

    encode gzip

    # Minimal hardening for a public agent-facing web app
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }
}

# The node's own .cyberspace name — enable on the node that owns the name
# (live on the genesis host since 2026-10-12). The name resolves only
# through the house resolver stack (cybernet-resolver), so there is no
# ACME/public DNS for it: the explicit http:// scheme is REQUIRED, both
# here and on the PUBLIC_HOSTNAME block if it is a bare IP — without it
# Caddy silently upgrades the site to HTTPS-on-restart and the plain-HTTP
# face becomes a redirect to an untrusted internal cert.
#
# http://genesis.cyberspace {
#     reverse_proxy 127.0.0.1:8471
#
#     encode gzip
#
#     header {
#         X-Content-Type-Options nosniff
#         X-Frame-Options DENY
#         Referrer-Policy no-referrer
#         -Server
#     }
# }
